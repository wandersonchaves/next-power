generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  customers Customer[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Customer {
  id              String    @id @default(cuid())
  name            String
  cpf             String    @unique
  birthDate       DateTime?
  phone           String?
  email           String?
  address         String?
  postalCode      String?
  spouseName      String?
  status          String    @default("pending")
  carnetGenerated Boolean   @default(false)

  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carnets Carnet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Carnet {
  id String @id @default(cuid())

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  carnetId   String  @unique
  status     String
  repeats    Int
  value      Int
  cover      String
  link       String
  carnetLink String?
  pdf        String

  createdAt DateTime @default(now())
  charges   Charge[]

  history Json
}

model Charge {
  id String @id @default(cuid())

  carnet   Carnet @relation(fields: [carnetId], references: [id])
  carnetId String

  chargeId   String @unique
  status     String
  url        String
  barcode    String
  pdf        String
  pixQrCode  String
  pixQrImage String
  parcel     Int
  value      Int

  expireAt  DateTime
  createdAt DateTime @default(now())

  configurations Json
}
